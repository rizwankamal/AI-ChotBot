{% comment %}
  ShopPulse AI — self-contained embed (inline CSS/JS so theme CDN cache cannot keep the old UI).
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">

<div
  id="shoppulse-chat-root"
  data-shop="{{ shop.permanent_domain }}"
  data-api-url="{{ block.settings.api_base_url | default: 'https://detroit-interfaces-coupled-syndrome.trycloudflare.com' }}/api/v1/chat/stream"
  data-title="{{ block.settings.widget_title | escape }}"
  data-version="2026-10-29-inline-v7"
></div>

<style>
  #shoppulse-chat-root {
    --sp-bg: #0b0c10;
    --sp-panel: #11131a;
    --sp-soft: #1a1e2a;
    --sp-line: rgba(255, 255, 255, 0.09);
    --sp-text: #f6f3ec;
    --sp-muted: #9aa1b3;
    --sp-accent: #d4ff4f;
    --sp-accent-ink: #10140a;
    --sp-card: #171b26;
    --sp-shadow: 0 30px 80px rgba(0, 0, 0, 0.55);
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 2147483000;
    font-family: 'Manrope', system-ui, sans-serif;
    color: var(--sp-text);
    -webkit-font-smoothing: antialiased;
  }

  #shoppulse-chat-root .sp-launcher {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 0;
    border-radius: 999px;
    padding: 15px 22px;
    background: var(--sp-accent);
    color: var(--sp-accent-ink);
    font-family: 'Manrope', sans-serif;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0;
    cursor: pointer;
    box-shadow: var(--sp-shadow);
    transition: transform 0.22s ease, filter 0.22s ease;
  }

  #shoppulse-chat-root .sp-launcher:hover {
    transform: translateY(-2px) scale(1.02);
    filter: brightness(1.05);
  }

  #shoppulse-chat-root .sp-launcher-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--sp-accent-ink);
    animation: sp-pulse 1.7s ease infinite;
  }

  @keyframes sp-pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(0.82); opacity: 0.65; }
  }

  #shoppulse-chat-root .sp-panel {
    display: none;
    width: min(440px, calc(100vw - 24px));
    height: min(680px, calc(100vh - 96px));
    margin-bottom: 14px;
    background:
      radial-gradient(ellipse at 100% 0%, rgba(212, 255, 79, 0.16), transparent 42%),
      radial-gradient(ellipse at 0% 100%, rgba(110, 140, 255, 0.14), transparent 40%),
      var(--sp-panel);
    border: 1px solid var(--sp-line);
    border-radius: 28px;
    overflow: hidden;
    box-shadow: var(--sp-shadow);
    flex-direction: column;
    opacity: 0;
    transform: translateY(18px) scale(0.96);
  }

  #shoppulse-chat-root .sp-panel.is-open {
    display: flex;
    animation: sp-open 0.38s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  #shoppulse-chat-root .sp-panel.is-closing {
    display: flex;
    animation: sp-close 0.22s ease forwards;
  }

  @keyframes sp-open {
    from { opacity: 0; transform: translateY(18px) scale(0.96); }
    to { opacity: 1; transform: none; }
  }

  @keyframes sp-close {
    from { opacity: 1; transform: none; }
    to { opacity: 0; transform: translateY(12px) scale(0.97); }
  }

  #shoppulse-chat-root .sp-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 18px;
    border-bottom: 1px solid var(--sp-line);
  }

  #shoppulse-chat-root .sp-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  #shoppulse-chat-root .sp-avatar {
    width: 44px;
    height: 44px;
    border-radius: 15px;
    display: grid;
    place-items: center;
    background: linear-gradient(145deg, var(--sp-accent), #9ad40f);
    color: var(--sp-accent-ink);
    font-family: 'Manrope', sans-serif;
    font-weight: 800;
    font-size: 15px;
    flex-shrink: 0;
  }

  #shoppulse-chat-root .sp-header-title {
    font-family: 'Manrope', sans-serif;
    font-weight: 700;
    font-size: 16px;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  #shoppulse-chat-root .sp-header-sub {
    margin-top: 3px;
    font-size: 12px;
    color: var(--sp-muted);
    font-weight: 600;
  }

  #shoppulse-chat-root .sp-header-close {
    width: 36px;
    height: 36px;
    border: 1px solid var(--sp-line);
    border-radius: 12px;
    background: var(--sp-soft);
    color: var(--sp-text);
    cursor: pointer;
    font-size: 20px;
    line-height: 1;
  }

  #shoppulse-chat-root .sp-messages {
    flex: 1;
    overflow-y: auto;
    padding: 18px 16px;
  }

  #shoppulse-chat-root .sp-msg {
    max-width: 92%;
    margin: 0 0 12px;
    padding: 12px 14px;
    border-radius: 18px;
    line-height: 1.5;
    font-size: 14px;
    font-weight: 600;
    opacity: 0;
    transform: translateY(8px);
    animation: sp-msg-in 0.32s ease forwards;
  }

  @keyframes sp-msg-in {
    to { opacity: 1; transform: none; }
  }

  #shoppulse-chat-root .sp-msg.bot {
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid var(--sp-line);
    color: #efece4;
    white-space: pre-wrap;
  }

  #shoppulse-chat-root .sp-msg.user {
    margin-left: auto;
    background: var(--sp-accent);
    color: var(--sp-accent-ink);
    font-weight: 700;
    white-space: pre-wrap;
    border-bottom-right-radius: 6px;
  }

  #shoppulse-chat-root .sp-msg.greeting {
    background: linear-gradient(160deg, rgba(212, 255, 79, 0.12), rgba(255, 255, 255, 0.03));
    border-color: rgba(212, 255, 79, 0.22);
  }

  #shoppulse-chat-root .sp-msg.bot .sp-link {
    color: var(--sp-accent);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid rgba(212, 255, 79, 0.35);
  }

  #shoppulse-chat-root .sp-products {
    display: grid;
    gap: 10px;
    margin: 0 0 14px;
  }

  #shoppulse-chat-root .sp-content-links {
    display: grid;
    gap: 14px;
    margin: 0 0 14px;
  }

  #shoppulse-chat-root .sp-content-group {
    display: grid;
    gap: 8px;
  }

  #shoppulse-chat-root .sp-content-heading {
    font-family: 'Manrope', sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--sp-muted);
    padding-left: 2px;
  }

  #shoppulse-chat-root .sp-content-link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 10px;
    align-items: center;
    padding: 12px 14px;
    border-radius: 16px;
    background: var(--sp-card);
    border: 1px solid var(--sp-line);
    text-decoration: none;
    color: inherit;
    transition: transform 0.18s ease, border-color 0.18s ease;
  }

  #shoppulse-chat-root .sp-content-link:hover {
    transform: translateY(-1px);
    border-color: rgba(212, 255, 79, 0.4);
  }

  #shoppulse-chat-root .sp-content-type {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sp-accent-ink);
    background: var(--sp-accent);
    padding: 4px 8px;
    border-radius: 999px;
  }

  #shoppulse-chat-root .sp-content-title {
    font-family: 'Manrope', sans-serif;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.3;
    color: #fff;
    min-width: 0;
  }

  #shoppulse-chat-root .sp-content-cta {
    font-size: 12px;
    font-weight: 700;
    color: var(--sp-muted);
    white-space: nowrap;
  }

  #shoppulse-chat-root .sp-content-link:hover .sp-content-cta {
    color: var(--sp-accent);
  }

  #shoppulse-chat-root .sp-card {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 12px;
    padding: 10px;
    border-radius: 20px;
    background: var(--sp-card);
    border: 1px solid var(--sp-line);
    text-decoration: none;
    color: inherit;
    transition: transform 0.18s ease, border-color 0.18s ease;
    animation: sp-msg-in 0.35s ease forwards;
  }

  #shoppulse-chat-root .sp-card:hover {
    transform: translateY(-2px);
    border-color: rgba(212, 255, 79, 0.4);
  }

  #shoppulse-chat-root .sp-card-image,
  #shoppulse-chat-root .sp-card-image.placeholder {
    width: 88px;
    height: 88px;
    border-radius: 14px;
    object-fit: cover;
    background: linear-gradient(145deg, #2a3142, #141821);
  }

  #shoppulse-chat-root .sp-card-image.placeholder {
    display: grid;
    place-items: center;
    color: var(--sp-muted);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  #shoppulse-chat-root .sp-card-body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
  }

  #shoppulse-chat-root .sp-card-title {
    font-family: 'Manrope', sans-serif;
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: #fff;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  #shoppulse-chat-root .sp-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  #shoppulse-chat-root .sp-price {
    font-weight: 800;
    font-size: 14px;
    color: var(--sp-accent);
  }

  #shoppulse-chat-root .sp-stock {
    display: inline-flex;
    padding: 3px 9px;
    border-radius: 999px;
    background: rgba(212, 255, 79, 0.12);
    color: #e2ff8a;
    font-size: 11px;
    font-weight: 600;
  }

  #shoppulse-chat-root .sp-stock.out {
    background: rgba(255, 90, 90, 0.12);
    color: #ff9b9b;
  }

  #shoppulse-chat-root .sp-card-cta {
    font-size: 12px;
    font-weight: 600;
    color: var(--sp-muted);
  }

  #shoppulse-chat-root .sp-card:hover .sp-card-cta {
    color: var(--sp-accent);
  }

  #shoppulse-chat-root .sp-form {
    display: flex;
    gap: 10px;
    padding: 14px 14px 16px;
    border-top: 1px solid var(--sp-line);
    background: rgba(0, 0, 0, 0.28);
  }

  #shoppulse-chat-root .sp-form input {
    flex: 1;
    border: 1px solid var(--sp-line);
    border-radius: 16px;
    padding: 13px 15px;
    font: inherit;
    font-weight: 600;
    color: var(--sp-text);
    background: var(--sp-soft);
    outline: none;
  }

  #shoppulse-chat-root .sp-form input::placeholder {
    color: #7f8799;
  }

  #shoppulse-chat-root .sp-form input:focus {
    border-color: rgba(212, 255, 79, 0.5);
    box-shadow: 0 0 0 3px rgba(212, 255, 79, 0.12);
  }

  #shoppulse-chat-root .sp-form button {
    border: 0;
    border-radius: 16px;
    padding: 0 18px;
    background: var(--sp-accent);
    color: var(--sp-accent-ink);
    font-family: 'Manrope', sans-serif;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
  }

  @media (max-width: 480px) {
    #shoppulse-chat-root {
      right: 10px;
      bottom: 10px;
    }
    #shoppulse-chat-root .sp-panel {
      width: calc(100vw - 20px);
      height: min(78vh, 680px);
    }
  }
</style>

<script>
(() => {
  const root = document.getElementById('shoppulse-chat-root');
  if (!root || root.dataset.spBooted === '1') return;
  root.dataset.spBooted = '1';

  const shop = root.dataset.shop;
  const apiUrl = root.dataset.apiUrl;
  const title = root.dataset.title || 'Shopping Assistant';
  const hour = new Date().getHours();
  const hello = hour < 12 ? 'Good morning' : hour < 18 ? 'Good afternoon' : 'Good evening';

  root.innerHTML = `
    <div class="sp-panel" id="sp-panel" aria-hidden="true">
      <div class="sp-header">
        <div class="sp-brand">
          <div class="sp-avatar" aria-hidden="true">AI</div>
          <div>
            <div class="sp-header-title"></div>
            <div class="sp-header-sub">Personal stylist · live catalog</div>
          </div>
        </div>
        <button type="button" class="sp-header-close" id="sp-close" aria-label="Close">×</button>
      </div>
      <div class="sp-messages" id="sp-messages"></div>
      <form class="sp-form" id="sp-form">
        <input id="sp-input" type="text" placeholder="Try: woolen clothes, hoodie…" autocomplete="off" required />
        <button type="submit">Send</button>
      </form>
    </div>
    <button type="button" class="sp-launcher" id="sp-launcher">
      <span class="sp-launcher-dot" aria-hidden="true"></span>
      Shop Assistant
    </button>
  `;

  root.querySelector('.sp-header-title').textContent = title;

  const panel = root.querySelector('#sp-panel');
  const launcher = root.querySelector('#sp-launcher');
  const closer = root.querySelector('#sp-close');
  const form = root.querySelector('#sp-form');
  const input = root.querySelector('#sp-input');
  const messages = root.querySelector('#sp-messages');
  let greeted = false;

  const escapeHtml = (text) => String(text)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');

  const cleanBotText = (text) => text
    .replace(/\*\*([^*]+)\*\*/g, '$1')
    .replace(/\n{3,}/g, '\n\n')
    .trim();

  const formatBotHtml = (text) => {
    const cleaned = cleanBotText(text);
    const placeholders = [];
    const withPlaceholders = cleaned.replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g, function (_, label, url) {
      const token = '__SPLINK' + placeholders.length + '__';
      placeholders.push('<a class="sp-link" href="' + escapeHtml(url) + '" target="_blank" rel="noopener noreferrer">' + escapeHtml(label) + '</a>');
      return token;
    });
    let html = escapeHtml(withPlaceholders);
    html = html.replace(/(https?:\/\/[^\s<]+)/g, '<a class="sp-link" href="$1" target="_blank" rel="noopener noreferrer">$1</a>');
    for (let i = 0; i < placeholders.length; i++) {
      html = html.replace('__SPLINK' + i + '__', placeholders[i]);
    }
    return html;
  };

  const money = (price) => {
    const n = Number(price);
    return Number.isFinite(n)
      ? new Intl.NumberFormat(undefined, { style: 'currency', currency: 'USD' }).format(n)
      : '$' + price;
  };

  const appendMessage = (text, who, extraClass) => {
    const el = document.createElement('div');
    el.className = 'sp-msg ' + who + (extraClass ? ' ' + extraClass : '');
    if (who === 'bot') el.innerHTML = formatBotHtml(text);
    else el.textContent = text;
    messages.appendChild(el);
    messages.scrollTop = messages.scrollHeight;
    return el;
  };

  const setBotText = (el, text) => {
    el.innerHTML = formatBotHtml(text);
    messages.scrollTop = messages.scrollHeight;
  };

  const showGreeting = () => {
    if (greeted) return;
    greeted = true;
    appendMessage(
      hello + '! Welcome in. I can help you find sweatshirts, hoodies, knits, jackets, and more from this store — what are you looking for?',
      'bot',
      'greeting'
    );
  };

  const openPanel = () => {
    panel.classList.remove('is-closing');
    panel.classList.add('is-open');
    panel.setAttribute('aria-hidden', 'false');
    showGreeting();
    setTimeout(() => input.focus(), 280);
  };

  const closePanel = () => {
    panel.classList.remove('is-open');
    panel.classList.add('is-closing');
    panel.setAttribute('aria-hidden', 'true');
    setTimeout(() => panel.classList.remove('is-closing'), 220);
  };

  launcher.addEventListener('click', () => {
    if (panel.classList.contains('is-open')) closePanel();
    else openPanel();
  });
  closer.addEventListener('click', closePanel);

  const renderProducts = (items) => {
    if (!Array.isArray(items) || !items.length) return;
    const wrap = document.createElement('div');
    wrap.className = 'sp-products';
    const seen = new Set();

    items.forEach((item) => {
      const url = item && item.url;
      const titleText = (item && item.title) || 'Product';
      if (!url || seen.has(url)) return;
      seen.add(url);

      const stock = Number(item.inventory_count || 0);
      const card = document.createElement('a');
      card.className = 'sp-card';
      card.href = url;
      card.target = '_blank';
      card.rel = 'noopener noreferrer';
      card.innerHTML =
        (item.image_url
          ? '<img class="sp-card-image" src="' + escapeHtml(item.image_url) + '" alt="' + escapeHtml(titleText) + '" loading="lazy" />'
          : '<div class="sp-card-image placeholder">Look</div>') +
        '<div class="sp-card-body">' +
          '<div class="sp-card-title">' + escapeHtml(titleText) + '</div>' +
          '<div class="sp-card-meta">' +
            '<span class="sp-price">' + escapeHtml(money(item.price)) + '</span>' +
            '<span class="sp-stock ' + (stock > 0 ? '' : 'out') + '">' + (stock > 0 ? stock + ' in stock' : 'Sold out') + '</span>' +
          '</div>' +
          '<div class="sp-card-cta">View product →</div>' +
        '</div>';
      wrap.appendChild(card);
    });

    if (wrap.childElementCount) {
      messages.appendChild(wrap);
      messages.scrollTop = messages.scrollHeight;
    }
  };

  const renderContentLinks = (items) => {
    if (!Array.isArray(items) || !items.length) return;
    const groups = { page: [], article: [], policy: [] };
    const seen = new Set();

    items.forEach((item) => {
      const url = item && item.url;
      const titleText = (item && item.title) || 'Read more';
      if (!url || seen.has(url)) return;
      seen.add(url);
      const type = String((item && item.source_type) || 'page');
      if (type === 'article' || type === 'blog') groups.article.push({ url: url, titleText: titleText, label: 'Blog' });
      else if (type === 'policy') groups.policy.push({ url: url, titleText: titleText, label: 'Policy' });
      else groups.page.push({ url: url, titleText: titleText, label: 'Page' });
    });

    const wrap = document.createElement('div');
    wrap.className = 'sp-content-links';

    const appendGroup = (heading, rows) => {
      if (!rows.length) return;
      const section = document.createElement('div');
      section.className = 'sp-content-group';
      section.innerHTML = '<div class="sp-content-heading">' + escapeHtml(heading) + '</div>';
      rows.forEach((row) => {
        const link = document.createElement('a');
        link.className = 'sp-content-link';
        link.href = row.url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.innerHTML =
          '<span class="sp-content-type">' + escapeHtml(row.label) + '</span>' +
          '<span class="sp-content-title">' + escapeHtml(row.titleText) + '</span>' +
          '<span class="sp-content-cta">Open →</span>';
        section.appendChild(link);
      });
      wrap.appendChild(section);
    };

    appendGroup('Pages', groups.page);
    appendGroup('Blogs', groups.article);
    appendGroup('Policies', groups.policy);

    if (wrap.childElementCount) {
      messages.appendChild(wrap);
      messages.scrollTop = messages.scrollHeight;
    }
  };

  const buildRequestUrl = (base) => {
    try {
      const url = new URL(base, window.location.origin);
      if (url.hostname.includes('ngrok')) url.searchParams.set('ngrok-skip-browser-warning', 'true');
      return url.toString();
    } catch (e) {
      return base;
    }
  };

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const message = input.value.trim();
    if (!message) return;

    appendMessage(message, 'user');
    input.value = '';
    const bot = appendMessage('Finding pieces…', 'bot');
    let raw = '';
    let gotToken = false;
    let sawDone = false;
    let sawError = false;

    const applySsePayload = (payload) => {
      if (payload.type === 'token') {
        if (!gotToken) { raw = ''; gotToken = true; }
        raw += payload.content || '';
        setBotText(bot, raw);
      } else if (payload.type === 'products') {
        renderProducts(payload.items || []);
      } else if (payload.type === 'content_links') {
        renderContentLinks(payload.items || []);
      } else if (payload.type === 'error') {
        sawError = true;
        raw = payload.content || 'Sorry, I could not complete that request right now.';
        setBotText(bot, raw);
      } else if (payload.type === 'done') {
        sawDone = true;
      }
    };

    const flushSseBuffer = (chunk, carry) => {
      const merged = carry + chunk;
      const parts = merged.split('\n\n');
      const rest = parts.pop() || '';
      for (let i = 0; i < parts.length; i++) {
        const line = parts[i].trim();
        if (line.indexOf('data: ') !== 0) continue;
        try {
          applySsePayload(JSON.parse(line.slice(6)));
        } catch (e) {}
      }
      return rest;
    };

    try {
      const response = await fetch(buildRequestUrl(apiUrl), {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=UTF-8' },
        body: JSON.stringify({ message: message, shop: shop }),
      });

      if (!response.ok || !response.body) {
        setBotText(bot, 'Sorry, the assistant is unavailable right now.');
        return;
      }

      if ((response.headers.get('content-type') || '').toLowerCase().includes('text/html')) {
        setBotText(bot, 'Tunnel blocked the API. Use cloudflared and update the app URL.');
        return;
      }

      const reader = response.body.getReader();
      const decoder = new TextDecoder();
      let buffer = '';

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        buffer = flushSseBuffer(decoder.decode(value, { stream: true }), buffer);
      }

      buffer = flushSseBuffer(decoder.decode(), buffer);
      if (buffer.trim().indexOf('data: ') === 0) {
        try {
          applySsePayload(JSON.parse(buffer.trim().slice(6)));
        } catch (e) {}
      }

      if (sawError) setBotText(bot, raw);
      else if (!sawDone) setBotText(bot, 'Sorry, the reply was cut off. Please try again.');
      else if (!gotToken) setBotText(bot, 'No response received.');
      else setBotText(bot, raw);
    } catch (err) {
      setBotText(bot, 'Connection error. Check the ShopPulse app URL matches your live tunnel.');
      console.error('ShopPulse chat failed', err);
    }
  });
})();
</script>

